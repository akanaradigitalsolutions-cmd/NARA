# ── NARA secrets ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your keys. `.env` is git-ignored and must
# never be committed. In Phase 8 these move to the macOS Keychain.

# Anthropic API key — OPTIONAL. Only needed when config `cloud.backend: api`.
#
# On a Claude Pro/Max subscription (cloud.backend: cli, the default), LEAVE THIS
# BLANK and run `claude login` instead. Setting a key here makes Claude Code bill
# the pay-per-token API rather than drawing from your subscription quota.
#
# Create a key (api mode only) at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — premium cloud TTS voice (Phase 4). Leave blank to use local/macOS TTS.
ELEVENLABS_API_KEY=

# Optional — override the config file location (defaults to config/nara.yaml).
# NARA_CONFIG=config/nara.yaml
